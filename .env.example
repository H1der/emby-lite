# Docker Compose 环境变量示例：复制为 .env 后按需修改

HOST_PORT=8096
TZ=Asia/Shanghai

# 容器运行用户（NAS 建议设为宿主机目录属主：id -u / id -g；设为 0 则以 root 运行）
PUID=65532
PGID=65532

SERVER_NAME=Emby-Lite

# --- 数据库 ---
# 默认 SQLite（文件位于 /data/emby-lite.db）
DB_TYPE=sqlite
# 使用 PostgreSQL 时：
# DB_TYPE=postgres
# DSN=postgres://embylite:embylite_change_me@postgres:5432/embylite?sslmode=disable

# --- 可选 Redis 热缓存 ---
# 认证：docker-compose.redis.yml 会以此值同时设置服务端 requirepass 与客户端密码，
# 未设置时回退到内置默认口令（仅供本地试用，正式环境务必替换为强口令）
# REDIS_PASSWORD=<你的强口令>
# 客户端地址；若把密码写进 URL 则写法为 redis://:<口令>@redis:6379/0，且口令需 percent-encoding
# REDIS_URL=redis://redis:6379/0
# REDIS_DB=0
# REDIS_PREFIX=embylite:

# --- 可选：共享原 Emby 的 metadata 目录以复用/补全演员头像 ---
# EMBY_METADATA_DIR=/emby-metadata
# EMBY_METADATA_WRITEBACK=true
